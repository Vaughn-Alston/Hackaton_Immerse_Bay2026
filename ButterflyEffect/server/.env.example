# Copy to .env and paste your key. Never commit .env or put the key in the Unity project.
REACTOR_API_KEY=rk_replace_me
REACTOR_MODEL=reactor/visko-orbis-stable
PORT=8787
# Hard cap on each session, in seconds. Reactor bills per second while a session is live.
MAX_SESSION_SECONDS=900

# --- The Ripple (WebXR, /ripple/) ---
# Claude judges what the player said and directs the side stories. Without a key the server
# falls back to a keyword check and scripted side stories. Run `npm install` in server/ first.
ANTHROPIC_API_KEY=
# Speech-to-text for the Quest Browser, which has no built-in speech recognition.
# Any OpenAI-compatible /audio/transcriptions endpoint works. Without it, desktop Chrome
# uses its own speech recognition and the headset falls back to trigger = kind, grip = harsh.
STT_API_KEY=
# STT_URL=https://api.openai.com/v1/audio/transcriptions
# STT_MODEL=whisper-1
