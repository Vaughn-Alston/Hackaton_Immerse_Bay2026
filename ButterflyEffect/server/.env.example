# Copy to .env and paste your key. Never commit .env or put the key in the Unity project.
REACTOR_MODEL=reactor/visko-orbis-stable
PORT=8787
# Hard cap on each session, in seconds. Reactor bills per second while a session is live.
MAX_SESSION_SECONDS=900

# --- The Ripple (WebXR, /ripple/) ---
# Claude is the Global Story Director: it writes the side stories and the next encounter and
# choices for the main character. Without a key the episode uses the written scenarios and
# choices in public/ripple/content.js. Run `npm install` in server/ first.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
